OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional cheaper/faster model for the agriculture gate (default: reuse OPENROUTER_MODEL)
# OPENROUTER_FILTER_MODEL=openai/gpt-4o-mini
APP_NAME=Taung Thu Ye Khaung
CORS_ORIGINS=*

# Google Sign-In: comma-separated OAuth client IDs (iOS + Android native
# clients from Google Cloud Console). Empty = /auth/google returns 503.
GOOGLE_CLIENT_IDS=

# Semantic search (vector DB) settings
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# VECTOR_STORE_PATH=backend/chroma_store
# SEMANTIC_CANDIDATE_K=8
# MIN_SEMANTIC_SCORE=0.0   # cross-encoder relevance threshold; >0 = strong match
