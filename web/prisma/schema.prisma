// Admin portal schema (SQLite) — FarmBot Myanmar knowledge + analytics.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Knowledge base articles — source of truth seeded from data/agriculture.csv.
model Article {
  id        String   @id
  title     String
  category  String   // legacy single-value; prefer categories relation
  crop      String?  // legacy single-value; prefer crops relation
  content   String
  source    String?
  tags      String?  // comma-separated
  region    String?
  language  String   @default("my")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories ArticleCategory[]
  crops      ArticleCrop[]
}

// Junction: one article can have many categories.
model ArticleCategory {
  id       Int    @id @default(autoincrement())
  articleId String
  category String  // cultivation | disease | fertilizer | pest | prevention | water_management
  article  Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, category])
}

// Junction: one article can have many crops.
model ArticleCrop {
  id       Int    @id @default(autoincrement())
  articleId String
  crop     String  // bean | cabbage | chili | eggplant | general | maize | onion | rice | tomato
  article  Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, crop])
}

// Admin-managed taxonomy backing the article form dropdowns. Seeded from
// src/lib/taxonomy.ts; admins can extend it via "+" in the article form.
model TaxonomyTerm {
  id        Int      @id @default(autoincrement())
  type      String // "category" | "crop"
  value     String // canonical lowercase value stored on articles
  en        String // English display name
  mm        String // Myanmar display name
  createdAt DateTime @default(now())

  @@unique([type, value])
}

// User feedback — written by the FastAPI backend (mobile thumbs up/down) and
// seeded from backend/feedback.jsonl; the portal only reviews these rows.
model Feedback {
  id             Int      @id @default(autoincrement())
  ts             DateTime
  useful         Boolean
  message        String
  answer         String
  sourceIds      String // JSON array of article ids
  reason         String? // why not useful — prd.md §16
  comment        String? // free-text detail — prd.md §16
  conversationId String? // mobile chat conversation id — prd.md §16
  createdAt      DateTime @default(now())
}

// Registered mobile app users — passwords stored as SHA-256 hashes
// (Google Sign-In users carry the "google-oauth" sentinel instead).
model User {
  id           String   @id
  username     String   @unique
  displayName  String
  passwordHash String
  email        String?  @unique
  createdAt    DateTime @default(now())
}

// Interaction dataset (prd.md §17) — future: backend will append one row per
// chat turn (question, intent, entities, retrieved docs, response time).
model QuestionLog {
  id         Int      @id @default(autoincrement())
  ts         DateTime @default(now())
  question   String
  intent     String?
  entities   String? // JSON
  outOfScope Boolean?
  usedLlm    Boolean?
  sourceIds  String? // JSON array
  answer     String?
  responseMs Int?
  userId     String? // device/user id from mobile app
}
